{
  "name": "@poultry/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:perf": "tsx prisma/seed-perf.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@poultry/shared-types": "workspace:^",
    "@poultry/validation": "workspace:^",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "pino-pretty": "^13.1.3",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^5.0.1"
  }
}
